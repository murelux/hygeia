<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hygeia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="hygeia">
    <Grid x:Name="RootGrid">
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            PaneTitle="hygeia"
            Header="风扇与温度"
            SelectionChanged="NavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="FansNav" Content="风扇与温度" Tag="fans">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MachineNav" Content="本机" Tag="machine">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <ScrollViewer x:Name="FansPage" Padding="8,4,28,20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="StatusText" Text="正在连接驱动" Opacity="0.8" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="CPU" Opacity="0.7" />
                                    <TextBlock x:Name="CpuCoreText" Text="—" Style="{ThemeResource TitleTextBlockStyle}" />
                                    <TextBlock x:Name="CpuFanText" Text="风扇 —" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="GPU" Opacity="0.7" />
                                    <TextBlock x:Name="GpuCoreText" Text="—" Style="{ThemeResource TitleTextBlockStyle}" />
                                    <TextBlock x:Name="GpuSourceText" Opacity="0.7" />
                                    <TextBlock x:Name="GpuFanText" Text="风扇 —" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <InfoBar Grid.Row="1" Grid.ColumnSpan="2" x:Name="EmergencyBar" IsOpen="False" Severity="Warning" Title="温度过高" Message="风扇已临时拉到 100%，温度回落后恢复当前模式。" />
                        </Grid>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SpeedTitle" Text="调速" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="AutoMode" Content="自动" GroupName="Mode" IsChecked="True" Checked="ModeChanged" />
                                <RadioButton x:Name="ManualMode" Content="手动" GroupName="Mode" Checked="ModeChanged" />
                            </StackPanel>
                            <CheckBox x:Name="StartupBox" Content="开机时在后台运行" Checked="StartupChanged" Unchecked="StartupChanged" />
                            <TextBlock x:Name="LanguageLabel" Text="语言" />
                            <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" HorizontalAlignment="Left" MinWidth="180">
                                <ComboBoxItem x:Name="ChineseItem" Content="简体中文" Tag="zh-CN" />
                                <ComboBoxItem x:Name="EnglishItem" Content="English" Tag="en" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="AutoPanel" Spacing="12">
                            <TextBlock x:Name="AutoHint" Text="低于第一条用第一条的占空比，高于最后一条用最后一条。至少保留两条，相同温度只留一条。" Opacity="0.75" TextWrapping="Wrap" />
                            <TextBlock x:Name="CpuFanTitle" Text="CPU 风扇" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel x:Name="CpuPointsPanel" Spacing="8" />
                            <Button x:Name="AddCpuPointButton" Content="添加 CPU 条件" Click="AddCpuPoint" HorizontalAlignment="Left" />
                            <TextBlock x:Name="GpuFanTitle" Text="GPU 风扇" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel x:Name="GpuPointsPanel" Spacing="8" />
                            <Button x:Name="AddGpuPointButton" Content="添加 GPU 条件" Click="AddGpuPoint" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Spacing="14">
                            <TextBlock x:Name="ManualHint" Text="拖动后约一秒写入。关闭窗口会留在托盘里继续调速。" Opacity="0.75" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="CpuSliderLabel" Text="CPU 风扇 40%" />
                                <Slider x:Name="CpuSlider" Minimum="0" Maximum="100" Value="40" StepFrequency="1" ValueChanged="SliderChanged" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="GpuSliderLabel" Text="GPU 风扇 40%" />
                                <Slider x:Name="GpuSlider" Minimum="0" Maximum="100" Value="40" StepFrequency="1" ValueChanged="SliderChanged" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="FooterText" Opacity="0.65" TextWrapping="Wrap"
                                   Text="关闭窗口会留在托盘里继续按当前模式调速。从托盘退出，或温度全部读失败时，风扇交回固件。温度达到 95°C 时两路风扇临时拉到 100%。" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="MachinePage" Visibility="Collapsed" Padding="8,4,28,20">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="DeviceTitle" Text="—" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="ModelSubtitle" Text="—" Opacity="0.75" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="CardProcessorLabel" Text="处理器" Opacity="0.7" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CardProcessor" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CardProcessorSpeed" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="CardMemoryLabel" Text="内存" Opacity="0.7" />
                                    <TextBlock x:Name="CardMemory" Text="—" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="CardGraphicsLabel" Text="显卡" Opacity="0.7" />
                                    <TextBlock x:Name="CardGraphics" Text="—" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Padding="16" CornerRadius="8" BorderThickness="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="CardStorageLabel" Text="存储" Opacity="0.7" />
                                    <TextBlock x:Name="CardStorage" Text="—" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="CardStorageUsed" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Padding="4,8" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock x:Name="DeviceSectionTitle" Text="设备信息" Margin="12,8,12,4" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <Grid x:Name="DeviceRows" Padding="12,4,12,8" ColumnSpacing="24" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="ComputerLabel" Text="计算机" Opacity="0.8" />
                                    <TextBlock x:Name="ComputerValue" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DeviceNameLabel" Grid.Row="1" Text="设备名称" Opacity="0.8" />
                                    <TextBlock x:Name="DeviceNameValue" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ProcessorLabel" Grid.Row="2" Text="处理器" Opacity="0.8" />
                                    <TextBlock x:Name="ProcessorValue" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MemoryLabel" Grid.Row="3" Text="内存" Opacity="0.8" />
                                    <TextBlock x:Name="MemoryValue" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="GraphicsLabel" Grid.Row="4" Text="显卡" Opacity="0.8" />
                                    <TextBlock x:Name="GraphicsValue" Grid.Row="4" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="StorageLabel" Grid.Row="5" Text="存储" Opacity="0.8" />
                                    <TextBlock x:Name="StorageValue" Grid.Row="5" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="BiosLabel" Grid.Row="6" Text="BIOS" Opacity="0.8" />
                                    <TextBlock x:Name="BiosValue" Grid.Row="6" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="FanDriverLabel" Grid.Row="7" Text="风扇驱动" Opacity="0.8" />
                                    <TextBlock x:Name="FanDriverValue" Grid.Row="7" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Padding="4,8" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock x:Name="DriverSectionTitle" Text="驱动" Margin="12,8,12,4" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <StackPanel x:Name="DriverRows" Padding="12,4,12,8" Spacing="10" />
                            </StackPanel>
                        </Border>
                        <Border Padding="4,8" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock x:Name="WindowsSectionTitle" Text="Windows 信息" Margin="12,8,12,4" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <Grid Padding="12,4,12,8" ColumnSpacing="24" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="EditionLabel" Text="版本" Opacity="0.8" />
                                    <TextBlock x:Name="EditionValue" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="VersionLabel" Grid.Row="1" Text="版本号" Opacity="0.8" />
                                    <TextBlock x:Name="VersionValue" Grid.Row="1" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="BuildLabel" Grid.Row="2" Text="内部版本" Opacity="0.8" />
                                    <TextBlock x:Name="BuildValue" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SystemTypeLabel" Grid.Row="3" Text="系统类型" Opacity="0.8" />
                                    <TextBlock x:Name="SystemTypeValue" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="hygeia"
            ContextMenuMode="PopupMenu" MenuActivation="None" NoLeftClickDelay="True"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="0"
            Height="0">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="ShowItem" Text="显示" Click="ShowFromTray" />
                    <MenuFlyoutItem x:Name="ExitItem" Text="退出" Click="ExitFromTray" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
