<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Hygeia.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="hygeia">
    <Grid x:Name="RootGrid">
        <Grid Padding="28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitle" Text="风扇与温度" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="StatusText" Text="正在连接驱动" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Column="0" Padding="16" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CPU" Opacity="0.7" />
                        <TextBlock x:Name="CpuCoreText" Text="—" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="CpuFanText" Text="风扇 —" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="GPU" Opacity="0.7" />
                        <TextBlock x:Name="GpuCoreText" Text="—" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="GpuSourceText" Opacity="0.7" />
                        <TextBlock x:Name="GpuFanText" Text="风扇 —" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <InfoBar Grid.Row="1" Grid.ColumnSpan="2" x:Name="EmergencyBar" IsOpen="False" Severity="Warning" Title="温度过高" Message="风扇已临时拉到 100%，温度回落后恢复当前模式。" />
            </Grid>

            <StackPanel Grid.Row="2" Spacing="8">
                <TextBlock x:Name="SpeedTitle" Text="调速" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="AutoMode" Content="自动" GroupName="Mode" IsChecked="True" Checked="ModeChanged" />
                    <RadioButton x:Name="ManualMode" Content="手动" GroupName="Mode" Checked="ModeChanged" />
                </StackPanel>
                <CheckBox x:Name="StartupBox" Content="开机时在后台运行" Checked="StartupChanged" Unchecked="StartupChanged" />
                <TextBlock x:Name="LanguageLabel" Text="语言" />
                <ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" HorizontalAlignment="Left" MinWidth="180">
                    <ComboBoxItem x:Name="ChineseItem" Content="简体中文" Tag="zh-CN" />
                    <ComboBoxItem x:Name="EnglishItem" Content="English" Tag="en" />
                </ComboBox>
            </StackPanel>

            <ScrollViewer Grid.Row="3">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="AutoPanel" Spacing="12">
                        <TextBlock x:Name="AutoHint" Text="低于第一条用第一条的占空比，高于最后一条用最后一条。至少保留两条，相同温度只留一条。" Opacity="0.75" TextWrapping="Wrap" />
                        <TextBlock x:Name="CpuFanTitle" Text="CPU 风扇" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="CpuPointsPanel" Spacing="8" />
                        <Button x:Name="AddCpuPointButton" Content="添加 CPU 条件" Click="AddCpuPoint" HorizontalAlignment="Left" />
                        <TextBlock x:Name="GpuFanTitle" Text="GPU 风扇" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="GpuPointsPanel" Spacing="8" />
                        <Button x:Name="AddGpuPointButton" Content="添加 GPU 条件" Click="AddGpuPoint" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Spacing="14">
                        <TextBlock x:Name="ManualHint" Text="拖动后约一秒写入。关闭窗口会留在托盘里继续调速。" Opacity="0.75" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CpuSliderLabel" Text="CPU 风扇 40%" />
                            <Slider x:Name="CpuSlider" Minimum="0" Maximum="100" Value="40" StepFrequency="1" ValueChanged="SliderChanged" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="GpuSliderLabel" Text="GPU 风扇 40%" />
                            <Slider x:Name="GpuSlider" Minimum="0" Maximum="100" Value="40" StepFrequency="1" ValueChanged="SliderChanged" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="FooterText" Grid.Row="4" Opacity="0.65" TextWrapping="Wrap"
                       Text="关闭窗口会留在托盘里继续按当前模式调速。从托盘退出，或温度全部读失败时，风扇交回固件。温度达到 95°C 时两路风扇临时拉到 100%。" />
        </Grid>
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="hygeia"
            ContextMenuMode="SecondWindow" NoLeftClickDelay="True"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="0"
            Height="0">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="ShowItem" Text="显示" Click="ShowFromTray" />
                    <MenuFlyoutItem x:Name="ExitItem" Text="退出" Click="ExitFromTray" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
